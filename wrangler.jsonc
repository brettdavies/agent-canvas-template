{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agent-canvas",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-30",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-canvas",
      // Replace with your D1 database id (`wrangler d1 create agent-canvas`) before deploy.
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "./worker/migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "QUERY_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
  // Add a custom domain when you deploy, e.g.:
  // "routes": [{ "pattern": "your-domain.example", "custom_domain": true }]
}
